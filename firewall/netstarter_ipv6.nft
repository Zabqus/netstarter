#!/usr/sbin/nft -f
#
# netstarter_ipv6.nft - WARIANT: blokada calego ruchu netstarter tylko po IPv6.
#
# Ladowanie:  sudo scripts/firewall.sh load ipv6
#
# Po IPv4 wszystko dziala, po IPv6 nic. Dodatkowo pokazuje roznice drop vs reject:
#   TCP 5000 -> reject with tcp reset : klient od razu dostaje "Connection refused"
#   UDP 5001 -> drop                  : klient czeka i dostaje timeout
#   proto 253 -> drop                 : klient czeka i dostaje timeout
#
# Ruch ICMPv6 (Neighbor Discovery, ping -6) nie jest ruszany - IPv6 jako takie dziala.

table inet netstarter
delete table inet netstarter

table inet netstarter {
    chain input {
        type filter hook input priority filter; policy accept;

        # IPv4 - jawnie przepuszczamy (liczniki pokaza, ze ruch v4 przechodzi)
        meta nfproto ipv4 tcp dport 5000 counter accept comment "netstarter: v4 TCP 5000 accept"
        meta nfproto ipv4 udp dport 5001 counter accept comment "netstarter: v4 UDP 5001 accept"
        ip protocol 253 counter accept comment "netstarter: v4 proto 253 accept"

        # IPv6 - blokada
        meta nfproto ipv6 tcp dport 5000 counter reject with tcp reset comment "netstarter: v6 TCP 5000 reject"
        meta nfproto ipv6 udp dport 5001 counter drop comment "netstarter: v6 UDP 5001 drop"
        meta nfproto ipv6 meta l4proto 253 counter drop comment "netstarter: v6 proto 253 drop"
    }
}
