#!/usr/sbin/nft -f
#
# netstarter.nft - podstawowe reguly firewalla dla serwera (etap 5.0).
#
# Ladowanie:  sudo scripts/firewall.sh load
#
# Wlasna tabela "inet netstarter" - NIE ruszamy domyslnej tabeli systemu (inet filter).
# Rodzina "inet" = jedna tabela dla IPv4 i IPv6 naraz.
#
#   TCP 5000   (tcp_server)  -> accept  (przechodzi)
#   UDP 5001   (udp_server)  -> drop    (pokaz blokady - klient dostaje timeout)
#   proto 253  (raw_server)  -> drop    (osobno IPv4 i IPv6, zeby miec osobne liczniki)
#
# Kazda regula ma "counter" - "nft list table inet netstarter" pokazuje, ile pakietow
# i bajtow w nia trafilo.

# Trik na ponowne ladowanie: utworz tabele (jesli nie ma) i od razu ja usun -
# dzieki temu kolejne "load" nie dubluje regul, a liczniki startuja od zera.
# Caly plik wykonuje sie atomowo (wszystko albo nic).
table inet netstarter
delete table inet netstarter

table inet netstarter {
    chain input {
        # Lancuch bazowy podpiety pod hook "input": pakiety adresowane DO tej maszyny,
        # juz po decyzji routingu, przed dostarczeniem do gniazda (takze surowego).
        # priority filter (= 0) - standardowy priorytet filtrowania.
        # policy accept - wszystko, czego nie dotycza nasze reguly, przechodzi dalej
        # (SSH, ICMP, ruch systemu) - blokujemy tylko wybrany ruch netstarter.
        type filter hook input priority filter; policy accept;

        # TCP echo - jawnie przepuszczamy (licznik pokaze, ze ruch tu trafil).
        tcp dport 5000 counter accept comment "netstarter: TCP 5000 accept"

        # UDP echo - po cichu wyrzucamy (bez ICMP) - klient czeka i dostaje timeout.
        udp dport 5001 counter drop comment "netstarter: UDP 5001 drop"

        # Wlasny protokol warstwy 3. "ip protocol" dopasowuje tylko IPv4.
        ip protocol 253 counter drop comment "netstarter: IPv4 proto 253 drop"

        # IPv6: "meta l4proto" to protokol warstwy 4 PO naglowkach rozszerzen IPv6.
        # "meta nfproto ipv6" zaweza regule do IPv6 (IPv4 zalatwila regula wyzej).
        meta nfproto ipv6 meta l4proto 253 counter drop comment "netstarter: IPv6 proto 253 drop"
    }
}
