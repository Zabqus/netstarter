#!/usr/sbin/nft -f
#
# netstarter.nft - reguly firewalla na serwerze (etap 5.0).
# Ladowanie:  sudo scripts/firewall.sh load
#
# Wlasna tabela "inet netstarter" (IPv4 + IPv6) - domyslnej tabeli systemu nie ruszamy.
#
#   TCP 5000   (tcp_server)  -> accept
#   UDP 5001   (udp_server)  -> drop
#   proto 253  (raw_server)  -> drop
#
# "counter" przy kazdej regule liczy pakiety, ktore w nia trafily.

# tworzymy tabele (jesli jej nie ma) i od razu usuwamy - ponowne load nie dubluje regul
table inet netstarter
delete table inet netstarter

table inet netstarter {
    chain input {
        # pakiety przychodzace do tej maszyny; reszta ruchu (policy accept) przechodzi
        type filter hook input priority filter; policy accept;

        # TCP echo - przepuszczamy
        tcp dport 5000 counter accept comment "netstarter: TCP 5000 accept"

        # UDP echo - wyrzucamy po cichu (klient dostaje timeout)
        udp dport 5001 counter drop comment "netstarter: UDP 5001 drop"

        # wlasny protokol 253 po IPv4
        ip protocol 253 counter drop comment "netstarter: IPv4 proto 253 drop"

        # wlasny protokol 253 po IPv6 (l4proto - za naglowkami rozszerzen IPv6)
        meta nfproto ipv6 meta l4proto 253 counter drop comment "netstarter: IPv6 proto 253 drop"
    }
}
