#!/usr/sbin/nft -f
#
# netstarter_client.nft - WARIANT: blokada tylko ruchu z adresu klienta (net-client).
#
# Ladowanie:  sudo scripts/firewall.sh load client
#
# Te same porty co w netstarter.nft, ale drop dotyczy wylacznie pakietow od
# 192.168.1.202 / fd00:10::202. Ruch z innych adresow (np. z samego serwera,
# z 127.0.0.1 / ::1) przechodzi normalnie.

define CLIENT_V4 = 192.168.1.202
define CLIENT_V6 = fd00:10::202

table inet netstarter
delete table inet netstarter

table inet netstarter {
    chain input {
        type filter hook input priority filter; policy accept;

        tcp dport 5000 counter accept comment "netstarter: TCP 5000 accept"

        # UDP 5001 - drop tylko od klienta (osobno IPv4 i IPv6)
        ip  saddr $CLIENT_V4 udp dport 5001 counter drop comment "netstarter: UDP 5001 drop (klient v4)"
        ip6 saddr $CLIENT_V6 udp dport 5001 counter drop comment "netstarter: UDP 5001 drop (klient v6)"

        # Protokol 253 - drop tylko od klienta
        ip  saddr $CLIENT_V4 ip protocol 253 counter drop comment "netstarter: proto 253 drop (klient v4)"
        ip6 saddr $CLIENT_V6 meta l4proto 253 counter drop comment "netstarter: proto 253 drop (klient v6)"
    }
}
